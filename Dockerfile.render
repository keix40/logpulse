FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.work go.work.sum ./
COPY pkg ./pkg
COPY deploy/alerts.yaml ./deploy/alerts.yaml
COPY services ./services
WORKDIR /src/services/all
RUN go mod download && CGO_ENABLED=0 go build -o /logpulse-all .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /logpulse-all /usr/local/bin/logpulse-all
COPY deploy/alerts.yaml /etc/logpulse/alerts.yaml
ENV ALERT_RULES_PATH=/etc/logpulse/alerts.yaml
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/logpulse-all"]
