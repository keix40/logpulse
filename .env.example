# Redis (local Compose — use REDIS_ADDR)
REDIS_ADDR=redis:6379
# Render / managed Redis (overrides REDIS_ADDR when set)
# REDIS_URL=rediss://:password@host:6379

# Ingest
INGEST_HTTP_ADDR=0.0.0.0:8080
INGEST_SYSLOG_ADDR=0.0.0.0:5514
INGEST_MAX_BODY_BYTES=2097152
REDIS_STREAM_MAXLEN=100000
# INGEST_API_KEY=change-me

# Storage
STORAGE_BACKEND=clickhouse
CLICKHOUSE_DSN=clickhouse://default:logpulse@clickhouse:9000/default
# STORAGE_BACKEND=postgres
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# LOG_RETENTION_HOURS=168

# Worker
WORKER_HTTP_ADDR=0.0.0.0:8081
WORKER_CORS_ORIGINS=http://localhost:3000
# READ_API_KEY=change-me

# Alerter
ALERTER_HTTP_ADDR=0.0.0.0:8082
ALERT_RULES_PATH=./deploy/alerts.yaml
ALERTER_MAX_NOTIFY_ATTEMPTS=5

# Notification webhooks (optional for local demo)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard
NEXT_PUBLIC_INGEST_URL=http://localhost:8080
NEXT_PUBLIC_WORKER_URL=http://localhost:8081
# Vercel server-side proxy to Render backend (keeps READ_API_KEY off the client)
WORKER_URL=http://worker:8081
# READ_API_KEY=

# Render all-in-one (services/all) uses PORT instead of separate HTTP addrs
# PORT=8080
